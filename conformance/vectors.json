      "steps": [
        {
          "op": "plan",
          "selectors": [
            "unknown:outside-map"
          ],
          "expect": {
            "status": "HOLD_UNKNOWN_SELECTOR",
            "unknown_selectors": [
              "unknown:outside-map"
            ],
            "current_sequence": 0
          }
        }
      ]
    },
