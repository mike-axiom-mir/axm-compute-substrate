{
  "format": "axm-neutral-compute-conformance",
  "version": "0.1",
  "note": "Plain JSON behavioral vectors. Expected HOLD/refusal states are successful conformance outcomes when named by the vector.",
  "hash_primitives": {
    "canonical_json": {
      "value": {
        "b": 2,
        "a": 1
      },
      "canonical_utf8": "{\"a\":1,\"b\":2}",
      "sha256": "43258cff783fe7036d8a43033f830adfc60ec037382473548ac742b888292777"
    },
    "bytes_base64": {
      "value": "AQID",
      "sha256": "039058c6f2c0cb492c533b0a4d14ef77cc0f78abccced5287d84a1a2011cfb81"
    }
  },
  "default_setup": {
    "contracts": [
      {
        "id": "graph",
        "depends_on": [
          "source:graph/**"
        ],
        "allowed_routes": [
          "incremental",
          "rebuild"
        ]
      },
      {
        "id": "snapshot",
        "depends_on": [
          "source:**"
        ],
        "allowed_routes": [
          "merkle",
          "full-audit"
        ]
      },
      {
        "id": "mesh",
        "depends_on": [
          "source:mesh/**"
        ],
        "allowed_routes": [
          "compile",
          "reuse-parser"
        ]
      }
    ],
    "artifacts": {
      "graph": {
        "kind": "json",
        "value": {
          "graph": 0
        }
      },
      "snapshot": {
        "kind": "json",
        "value": {
          "snapshot": 0
        }
      },
      "mesh": {
        "kind": "bytes-base64",
        "value": "bWVzaC12MA=="
      }
    }
  },
  "cases": [
    {
      "id": "selective-update-atomic-commit",
      "steps": [
        {
          "op": "plan",
          "save_as": "p1",
          "selectors": [
            "source:graph/node-7"
          ],
          "expect": {
            "status": "PLANNED",
            "actions": {
              "graph": "UPDATE_REQUIRED",
              "snapshot": "UPDATE_REQUIRED",
              "mesh": "REUSE_EXACT"
            },
            "current_sequence": 0
          }
        },
        {
          "op": "stage",
          "plan": "p1",
          "save_as": "s1",
          "updates": {
            "graph": {
              "body": {
                "kind": "json",
                "value": {
                  "graph": 1
                }
              },
              "route": "incremental"
            },
            "snapshot": {
              "body": {
                "kind": "json",
                "value": {
                  "snapshot": 1
                }
              },
              "route": "merkle"
            }
          },
          "expect": {
            "status": "STAGED",
            "current_sequence": 0,
            "staged_sequence": 1,
            "decisions": {
              "graph": "UPDATED",
              "snapshot": "UPDATED",
              "mesh": "REUSED_EXACT"
            }
          }
        },
        {
          "op": "commit",
          "stage": "s1",
          "save_generation": "g1",
          "expect": {
            "status": "COMMITTED",
            "current_sequence": 1,
            "decisions": {
              "graph": "UPDATED",
              "snapshot": "UPDATED",
              "mesh": "REUSED_EXACT"
            }
          }
        }
      ]
    },
    {
