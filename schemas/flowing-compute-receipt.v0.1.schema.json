{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiom-mir.example/schemas/flowing-compute-receipt.v0.1.schema.json",
  "title": "AXM Flowing Compute Receipt v0.1",
  "type": "object",
  "required": ["schema", "receipt_id", "subject", "source_identity", "equivalence", "cold", "flowing", "freshness", "derived", "trials", "truth", "receipt_sha256"],
  "properties": {
    "schema": {"const": "axm.flowing-compute-receipt/v0.1"},
    "receipt_id": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "required": ["id", "title", "units", "trials", "host"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "units": {"type": "integer", "minimum": 1},
        "trials": {"type": "integer", "minimum": 1},
        "host": {"type": "object"}
      }
    },
    "source_identity": {
      "type": "object",
      "required": ["files", "inline", "set_sha256", "identity_strength"],
      "properties": {
        "files": {"type": "array"},
        "inline": {"type": "object"},
        "set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "identity_strength": {"const": "sha256-content-identity"}
      }
    },
    "equivalence": {
      "type": "object",
      "required": ["contract", "passed", "output_sha256"],
      "properties": {
        "contract": {"type": "string"},
        "passed": {"const": true},
        "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "cold": {"type": "object", "required": ["cpu_median_ns", "wall_median_ns", "cpu_per_unit_ns"]},
    "flowing": {"type": "object", "required": ["cpu_median_ns", "wall_median_ns", "setup_cpu_median_ns", "service_cpu_median_ns", "retained_state", "reuse_count"]},
    "freshness": {"type": "object", "required": ["mode", "checked_during_probe"]},
    "derived": {"type": "object", "required": ["cpu_saved_percent_vs_cold", "useful_yield_multiplier_vs_cold", "estimated_setup_break_even_units", "estimate_withheld_reason"]},
    "trials": {"type": "array", "minItems": 1},
    "truth": {"type": "object"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
